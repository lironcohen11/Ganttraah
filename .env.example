# Gantraah configuration. Copy to .env and edit.
PORT=8080
# PostgreSQL connection. Leave empty to use the embedded database in DATA_DIR.
DATABASE_URL=
# DATA_DIR=./data/pglite
# First admin user (created only when there are no users). If ADMIN_PASSWORD is empty,
# a random password is generated and written to data/initial-admin.txt
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Load demo projects on an empty database
SEED_DEMO=false
# Set to true when served over HTTPS
COOKIE_SECURE=false
